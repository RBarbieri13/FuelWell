require "json"
require "digest"
require "pathname"
require "shellwords"
require "time"
require "uri"

opt_out_usage

default_platform(:ios)

platform :ios do
  before_all do
    setup_app_store_connect_api_key
  end

  desc "Run local quality and test gates"
  lane :test do
    sh("xcodegen generate --spec project.yml")
    sh("swiftlint --strict --config .swiftlint.yml")
    sh("scripts/check-feature-imports.sh")
    sh("scripts/check-theme-drift.sh")
    scan(
      scheme: "FuelWellApp",
      device: "iPhone 15",
      clean: true,
      output_directory: "fastlane/test_output"
    )
  end

  desc "Build and upload a TestFlight candidate"
  lane :beta do
    # On CI, codesign hangs forever unless the signing identity lives in an
    # unlocked keychain with the right partition list; setup_ci provides one.
    setup_ci if ENV["CI"]
    release_settings = testflight_release_settings
    sh("cd #{repo_root}/ios && xcodegen generate --spec project.yml")
    ensure_testflight_ready!
    build_number = testflight_build_number
    match(
      type: "appstore",
      readonly: true,
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]
    )
    increment_build_number(
      build_number: build_number
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "FuelWellApp.xcodeproj",
      targets: ["FuelWellApp"],
      team_id: ENV.fetch("FUELWELL_APPLE_TEAM_ID"),
      bundle_identifier: ENV.fetch("FUELWELL_APP_IDENTIFIER"),
      profile_name: "match AppStore #{ENV.fetch("FUELWELL_APP_IDENTIFIER")}",
      code_sign_identity: "Apple Distribution"
    )
    build_app(
      scheme: "FuelWellApp",
      export_method: "app-store",
      output_directory: "fastlane/build",
      export_team_id: ENV.fetch("FUELWELL_APPLE_TEAM_ID"),
      export_options: {
        provisioningProfiles: {
          ENV.fetch("FUELWELL_APP_IDENTIFIER") => "match AppStore #{ENV.fetch("FUELWELL_APP_IDENTIFIER")}"
        }
      },
      xcargs: [
        "CURRENT_PROJECT_VERSION=#{build_number}",
        "MARKETING_VERSION=#{release_settings.fetch(:package_version)}",
        "INFOPLIST_KEY_CFBundleVersion=#{build_number}",
        release_settings.fetch(:xcargs),
        "-skipMacroValidation",
        "-skipPackagePluginValidation"
      ].join(" ")
    )
    upload_to_testflight(
      skip_waiting_for_build_processing: false,
      distribute_external: false,
      notify_external_testers: false,
      changelog: ENV.fetch("FUELWELL_TESTFLIGHT_CHANGELOG", "FuelWell pilot build.")
    )
  end

  desc "Prepare App Store submission metadata and upload the reviewed build"
  lane :release do
    ensure_app_store_screenshots!
    beta
    upload_to_app_store(
      submit_for_review: false,
      automatic_release: false,
      phased_release: true,
      force: true,
      metadata_path: "fastlane/metadata",
      screenshots_path: "fastlane/screenshots"
    )
    sentry_release_tag
  end

  desc "Capture App Store screenshots from the verified immutable candidate"
  lane :screenshots do
    release_settings = testflight_release_settings
    sh("cd #{repo_root}/ios && xcodegen generate --spec project.yml")
    snapshot(
      xcargs: [
        "CODE_SIGNING_ALLOWED=NO",
        release_settings.fetch(:xcargs),
        "-skipMacroValidation",
        "-skipPackagePluginValidation"
      ].join(" ")
    )
    write_screenshot_manifest!
  end

  desc "Create the initial App Store signing assets for TestFlight"
  lane :bootstrap_signing do
    ensure_testflight_ready!
    match(
      type: "appstore",
      readonly: false,
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]
    )
  end

  private_lane :ensure_testflight_ready! do
    readiness_mode = ENV["CI"].to_s == "true" ? " --ci" : ""
    sh("#{repo_root}/tools/release/check-testflight-readiness.sh#{readiness_mode}")
  end

  private_lane :setup_app_store_connect_api_key do
    key_id = ENV["FUELWELL_ASC_KEY_ID"] || ENV["ASC_KEY_ID"]
    issuer_id = ENV["FUELWELL_ASC_ISSUER_ID"] || ENV["ASC_ISSUER_ID"]
    key_content = ENV["FUELWELL_ASC_KEY_P8_BASE64"] || ENV["ASC_KEY_P8_BASE64"]

    if key_id.to_s.empty? || issuer_id.to_s.empty? || key_content.to_s.empty?
      UI.important("App Store Connect API key env is not set; skipping API key setup for non-upload lanes.")
      next
    end

    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: true
    )
  end

  def testflight_build_number
    explicit_build_number = ENV["FUELWELL_BUILD_NUMBER"].to_s.strip
    return explicit_build_number unless explicit_build_number.empty?

    Time.now.utc.strftime("%Y%m%d%H%M")
  end

  def testflight_release_settings
    candidate_url = required_release_value("FUELWELL_CANDIDATE_URL").sub(%r{/+\z}, "")
    parsed_url = URI.parse(candidate_url)
    unless parsed_url.is_a?(URI::HTTPS) && parsed_url.host && parsed_url.path.to_s.empty? && parsed_url.query.nil?
      UI.user_error!("FUELWELL_CANDIDATE_URL must be an HTTPS deployment origin without a path or query")
    end

    package_version = JSON.parse(File.read(File.join(repo_root, "package.json"))).fetch("version")
    settings = {
      "FUELWELL_START_URL" => "#{candidate_url}/app/dashboard",
      "FUELWELL_EXPECTED_PACKAGE_VERSION" => package_version,
      "FUELWELL_EXPECTED_GIT_SHA" => required_release_value("FUELWELL_CANDIDATE_GIT_SHA"),
      "FUELWELL_EXPECTED_DEPLOYMENT_ID" => required_release_value("FUELWELL_CANDIDATE_DEPLOYMENT_ID"),
      "FUELWELL_EXPECTED_DEPLOYMENT_URL" => candidate_url,
      "FUELWELL_EXPECTED_ENVIRONMENT" => required_release_value("FUELWELL_CANDIDATE_ENVIRONMENT"),
      "FUELWELL_RELEASE_SCHEMA_VERSION" => "1"
    }

    {
      package_version: package_version,
      xcargs: settings.map { |key, value| "#{key}=#{Shellwords.escape(value)}" }.join(" ")
    }
  rescue JSON::ParserError, KeyError, URI::InvalidURIError => error
    UI.user_error!("Invalid TestFlight release provenance: #{error.message}")
  end

  def required_release_value(key)
    value = ENV[key].to_s.strip
    UI.user_error!("#{key} is required for a TestFlight candidate") if value.empty?
    value
  end

  def repo_root
    File.expand_path("../..", __dir__)
  end

  private_lane :ensure_app_store_screenshots! do
    screenshots = Dir.glob(File.join(__dir__, "screenshots", "en-US", "*.{png,jpg,jpeg}"))
    if screenshots.empty?
      UI.user_error!(
        "App Store screenshots are missing. Run `bundle exec fastlane ios screenshots` " \
        "after verifying the immutable candidate and before `fastlane ios release`."
      )
    end

    manifest_path = screenshot_manifest_path
    UI.user_error!("Screenshot candidate manifest is missing; recapture screenshots.") unless File.exist?(manifest_path)

    manifest = JSON.parse(File.read(manifest_path))
    settings = testflight_release_settings
    expected = {
      "git_sha" => ENV.fetch("FUELWELL_CANDIDATE_GIT_SHA"),
      "deployment_id" => ENV.fetch("FUELWELL_CANDIDATE_DEPLOYMENT_ID"),
      "deployment_url" => required_release_value("FUELWELL_CANDIDATE_URL").sub(%r{/+\z}, ""),
      "environment" => ENV.fetch("FUELWELL_CANDIDATE_ENVIRONMENT"),
      "package_version" => settings.fetch(:package_version)
    }
    expected.each do |key, value|
      UI.user_error!("Screenshot manifest #{key} does not match the release candidate; recapture screenshots.") unless manifest[key] == value
    end

    hashes = manifest.fetch("screenshots", {})
    screenshots.each do |file|
      relative = Pathname.new(file).relative_path_from(Pathname.new(File.join(__dir__, "screenshots"))).to_s
      expected_hash = hashes[relative]
      actual_hash = Digest::SHA256.file(file).hexdigest
      UI.user_error!("Screenshot #{relative} is missing from the candidate manifest.") if expected_hash.to_s.empty?
      UI.user_error!("Screenshot #{relative} changed after capture; recapture screenshots.") unless expected_hash == actual_hash
    end
    UI.user_error!("Screenshot candidate manifest contains stale files; recapture screenshots.") unless hashes.keys.sort == screenshots.map { |file| Pathname.new(file).relative_path_from(Pathname.new(File.join(__dir__, "screenshots"))).to_s }.sort
  end

  private_lane :write_screenshot_manifest! do
    screenshots_root = File.join(__dir__, "screenshots")
    screenshots = Dir.glob(File.join(screenshots_root, "en-US", "*.{png,jpg,jpeg}"))
    UI.user_error!("Snapshot finished without producing App Store screenshots.") if screenshots.empty?

    settings = testflight_release_settings
    manifest = {
      "schema_version" => 1,
      "captured_at" => Time.now.utc.iso8601,
      "git_sha" => ENV.fetch("FUELWELL_CANDIDATE_GIT_SHA"),
      "deployment_id" => ENV.fetch("FUELWELL_CANDIDATE_DEPLOYMENT_ID"),
      "deployment_url" => required_release_value("FUELWELL_CANDIDATE_URL").sub(%r{/+\z}, ""),
      "environment" => ENV.fetch("FUELWELL_CANDIDATE_ENVIRONMENT"),
      "package_version" => settings.fetch(:package_version),
      "screenshots" => screenshots.to_h do |file|
        relative = Pathname.new(file).relative_path_from(Pathname.new(screenshots_root)).to_s
        [relative, Digest::SHA256.file(file).hexdigest]
      end
    }
    File.write(screenshot_manifest_path, JSON.pretty_generate(manifest) + "\n")
  end

  def screenshot_manifest_path
    File.join(__dir__, "screenshots", "candidate-manifest.json")
  end

  private_lane :sentry_release_tag do
    if ENV["SENTRY_AUTH_TOKEN"].to_s.empty?
      UI.important("Skipping Sentry release tagging because SENTRY_AUTH_TOKEN is not set.")
      next
    end

    sh("which sentry-cli")
    sh(
      "sentry-cli releases new #{lane_context[SharedValues::BUILD_NUMBER]} " \
      "--org #{ENV.fetch('SENTRY_ORG')} --project #{ENV.fetch('SENTRY_PROJECT')}"
    )
  end
end
