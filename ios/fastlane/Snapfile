scheme("CandidateUITests")

devices([
  "iPhone 17 Pro Max", # 6.9-inch App Store family
  "iPhone 13 Pro Max", # 6.5-inch App Store family
  "iPhone 15" # Additional standard-size coverage retained by the readiness gate
])

only_testing([
  "FuelWellUITests/FuelWellCriticalPathUITests/testAppStoreCustomerScreenshots"
])

languages([
  "en-US"
])

launch_arguments([
  "--fuelwell-candidate-ui-test"
])

output_directory("./fastlane/screenshots")
buildlog_path("./fastlane/test_output")
clear_previous_screenshots(true)
override_status_bar(true)
localize_simulator(true)
reinstall_app(true)
erase_simulator(true)
stop_after_first_error(true)
number_of_retries(0)
result_bundle(true)
app_identifier("com.fuelwell.app")
